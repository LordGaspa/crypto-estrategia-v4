.venv/
__pycache__/
*.pyc
.claude/

# cache de candles - normalmente busca direto da Binance, não precisa ir pro repo.
# EXCEÇÃO: os 22 pares ativo/interval do portfólio (ATIVOS_PORTFOLIO_V4 em config_v4.py)
# vão versionados como fallback — a Binance bloqueia por geolocalização os IPs do
# Streamlit Community Cloud (hospedado nos EUA), então sem esse snapshot o app fica
# sem NENHUM dado no deploy. Ver carregar_dados() em config_v4.py: cai pro cache
# mesmo velho quando a API falha. Outros pares/intervals (testes de outros scripts,
# ex. FETUSDT_1d) continuam ignorados.
cache_dados/*
!cache_dados/1MBABYDOGEUSDT_4h.parquet
!cache_dados/API3USDT_12h.parquet
!cache_dados/BNBUSDT_12h.parquet
!cache_dados/BONKUSDT_4h.parquet
!cache_dados/BTCUSDT_6h.parquet
!cache_dados/DOGEUSDT_8h.parquet
!cache_dados/ETHUSDT_8h.parquet
!cache_dados/FETUSDT_4h.parquet
!cache_dados/FLOKIUSDT_4h.parquet
!cache_dados/HBARUSDT_8h.parquet
!cache_dados/IMXUSDT_6h.parquet
!cache_dados/INJUSDT_12h.parquet
!cache_dados/LINKUSDT_6h.parquet
!cache_dados/PENGUUSDT_4h.parquet
!cache_dados/PEPEUSDT_4h.parquet
!cache_dados/RENDERUSDT_4h.parquet
!cache_dados/SOLUSDT_8h.parquet
!cache_dados/SUIUSDT_6h.parquet
!cache_dados/TAOUSDT_4h.parquet
!cache_dados/TRXUSDT_8h.parquet
!cache_dados/XRPUSDT_8h.parquet
!cache_dados/ZECUSDT_4h.parquet

# cache do sistema de day-trade (Fase 1, ver daytrade_config.py) - candles
# intraday (5m/15m/1h), 8 ativos, ~85-95MB. Sem exceção nenhuma: essa fase não
# tem alvo de deploy que justifique versionar cache, diferente do cache_dados/
# acima (fallback do app_v4 no Streamlit Cloud).
cache_dados_daytrade/

# cache com coluna de volume (walkforward_v6i_volume_entrada.py) - o cache do v4
# descarta volume, entao esse script mantem o proprio. Mesma logica: dado gerado,
# nao versionar.
cache_dados_v6i/

# CSVs grandes de otimização (artefatos intermediários, não usados em tempo de execução pelo app_v4.py)
otimizador_v2_robustez_*.csv
otimizador_v3_trailing_*.csv
otimizador_v4_[A-Z0-9]*USDT.csv

# logs e locks locais
.streamlit/secrets.toml
*.lock
*.log

# grades do otimizador setorial v7 (172 arquivos, ~2.8MB cada) - saida gerada,
# regeneravel com otimizador_v7_setores.py. Os CSVs de RESUMO/analise sim vao pro repo.
otimizador_v7_[A-Z0-9]*USDT_*.csv
